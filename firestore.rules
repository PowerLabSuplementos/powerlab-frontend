rules_version = '2';
// Proposta. Este arquivo NÃO foi publicado.
// No console do Firebase: Firestore Database → Regras → colar → Publicar.
// Troque os dois placeholders pelo UID e pelo e-mail do administrador
// (Authentication → Users). O backend grava pedidos com a conta de serviço
// e não passa por estas regras.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.uid == 'COLE_AQUI_O_UID_DO_ADMIN'
          || request.auth.token.email == 'COLE_AQUI_O_EMAIL_DO_ADMIN'
        );
    }

    match /produtos/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
